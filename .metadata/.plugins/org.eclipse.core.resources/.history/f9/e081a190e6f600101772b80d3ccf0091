    public static String[][] JCllenarmatriz(int y, int x) {
        Scanner sc = new Scanner(System.in);
        String[][] matriu = new String[x][y];
    	for(int i = 0; i < matriu.length; i++) {
        	for(int w = 0; w < (matriu[0].length); w++) {
        		matriu[i][w] = sc.next();
        		System.out.println(matriu[i][w]);
        	}
        }
    	sc.close();
    	return matriu;
    }
    
}