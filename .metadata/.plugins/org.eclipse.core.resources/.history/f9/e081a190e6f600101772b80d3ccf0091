        sc.next();
        String[][] matriu = new String[x][y];
        matriu = JCllenarmatriz(x, y);
        System.out.println(matriu);
        sc.close();
        String r = "NO";
        for(int i = 0; i < matriu.length; i++) {
        	for(int w = 0; w < (matriu[0].length); w++) {
        		if(i >= 1) {
        			if(matriu[i - 1 ][w].equals("SPIDERMAN")) {
        				r = matriu[i - 1 ][w];
        				
        			}
        		}
        	}
        }
        System.out.println(r);
        		
