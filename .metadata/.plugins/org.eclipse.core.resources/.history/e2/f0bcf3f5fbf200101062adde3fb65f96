package ejercicios;

import java.util.*;

public class Oftalmólogo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        

        
        
        String[][] matriu = new String[2][2];
        matriu[0][0] = "1";
        matriu[0][1] = "2";
        matriu[1][0] = "3";
        matriu[1][1] = "4";
        String input = sc.nextLine();
        for(int i = 0; i < input.length(); i++) {
        	if(input.charAt(i) =='H') {
        		String x00 = matriu[0][0];
        		String x01 = matriu[0][1];
        		String x10 = matriu[1][0];
        		String x11 = matriu[1][1];
        		
        		matriu[0][0] = x10;
                matriu[0][1] = x11;
                matriu[1][0] = x00;
                matriu[1][1] = x01;
                
        	}else if(input.charAt(i) =='V'){
        		String x00 = matriu[0][0];
        		String x01 = matriu[0][1];
        		String x10 = matriu[1][0];
        		String x11 = matriu[1][1];
        		
        		matriu[0][0] = x01;
                matriu[0][1] = x00;
                matriu[1][0] = x11;
                matriu[1][1] = x10;
        	}else {
        		System.out.println("Error");
        	} 
        }
        System.out.println(matriu[0][0]+" "+matriu[0][1]);
        System.out.println(matriu[1][0]+" "+matriu[1][1]);

            
            		
    }
}