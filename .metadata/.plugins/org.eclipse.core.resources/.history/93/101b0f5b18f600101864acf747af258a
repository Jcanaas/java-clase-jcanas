package ejercicios;

import java.util.*;

public class Rectangle {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int x = sc.nextInt();
        int y = sc.nextInt();
        int xi = sc.nextInt();
        int yi = sc.nextInt();
        int xf = sc.nextInt();
        int yf = sc.nextInt();
        
        String[][] matriu = new String[x][y];
        for (int i = 0; i < matriu.length; i++) {
			for (int w = 0; w < (matriu[0].length); w++) {
				
				if(i >= xi && i <= xf && w >= yi && w <= yf ){
					matriu[i][w] = "X";
				}else {
					matriu[i][w] = ".";
				}
			}
		}
        
        sc.close();
        
        
                  		
    }
    static void JCllenarmatriz()String[][] matriu {
    	for(int i = 0; i < matriu.length; i++) {
        	for(int w = 0; w < (matriu[0].length); w++) {
        		matriu[i][w] = sc.nextInt();
        	}
        }
    	
    }
}