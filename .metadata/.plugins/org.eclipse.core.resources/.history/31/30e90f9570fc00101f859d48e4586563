    public static char[][] JCllenarmatriz(int filas, int cols, Scanner sc) {
        char[][] matriu = new char[filas][cols];
        for (int i = 0; i < filas; i++) {
            String linea = sc.next();
            for (int w = 0; w < cols; w++) {
                matriu[i][w] = linea.charAt(w);
            }
        }
