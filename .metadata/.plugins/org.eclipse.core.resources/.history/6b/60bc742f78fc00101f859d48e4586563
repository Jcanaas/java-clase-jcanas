package ejercicios;

import java.util.Scanner;

public class Tetris {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        

        
            int y = sc.nextInt();
            int x = sc.nextInt();
            
            int[][] matriu = JCllenarmatriz(y, x, sc);
                
            }
    	sc.close();
        

    
    public static int[][] JCllenarmatriz(int filas, int cols, Scanner sc) {
        int[][] matriu = new int[filas][cols];
        for (int i = 0; i < matriu.length; i++) {
            for (int w = 0; w < matriu[0].length; w++) {
                matriu[i][w] = sc.nextInt();
            }
        }
        return matriu;
    }
    
    
    public static boolean esticDins(int f, int c, char[][] matriu) {
        return f >= 0 && f < matriu.length && c >= 0 && c < matriu[f].length;
    }
}
