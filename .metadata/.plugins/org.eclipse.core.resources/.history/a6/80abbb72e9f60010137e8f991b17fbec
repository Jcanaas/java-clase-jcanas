package ejercicios;
import java.util.*;

public class Spederman2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int rows = sc.nextInt();
        int cols = sc.nextInt();

        String[][] matriu = JCllenarmatriz(sc, rows, cols);
        sc.close();

        String r1 = "NO";
        String r2 = "NO";
        for (int i = 0; i < rows && r1.equals("NO") && r2.equals("NO"); i++) {
            for (int w = 0; w < cols; w++) {
            	if(i >= 1) {
                if ("SPIDERMAN".equals(matriu[i][w])) {
                    r1 = matriu[i-1][w];
                    
                }}
            	if((i >= matriu.length) {
                    if ("SPIDERMAN".equals(matriu[i][w])) {
                        r1 = matriu[i+1][w];
                        
                    }}
            }
        }

        System.out.println(r1);
        System.out.println(r1);

        
    }

    public static String[][] JCllenarmatriz(Scanner sc, int rows, int cols) {
        String[][] matriu = new String[rows][cols];
        for (int i = 0; i < rows; i++) {
            for (int w = 0; w < cols; w++) {
                matriu[i][w] = sc.next();
            }
        }
        return matriu;
    }
}