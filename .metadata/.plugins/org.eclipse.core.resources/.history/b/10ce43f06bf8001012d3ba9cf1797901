package ejercicios;

import java.util.Scanner;

public class PUTOS_FURROS {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int x = 5;
        int y = 5;
        int[][] matriu = new int[y][x];
        
        matriu = JCllenarmatriz(5, 5, sc);
        int enemics = 0;
        for (int i = 0; i < matriu.length; i++) {
			for (int w = 0; w < (matriu[0].length); w++) {
				System.out.print(matriu[i][w] + " ");
			}
			System.out.println();
		}
        for (int dx = -1; dx <= 1; dx++) {
            for (int dy = -1; dy <= 1; dy++) {
                if (dx == 0 && dy == 0) {
                    
                } else {
                    int nx = x + dx;
                    int ny = y + dy;
                    if (esticDins(nx, ny, matriu)) {
                        enemics++;
                    }
                }
            }
        }
        System.out.println(enemics);
    }
    }
    public static int[][] JCllenarmatriz(int filas, int cols, Scanner sc) {
        int[][] matriu = new int[filas][cols];
        for (int i = 0; i < matriu.length; i++) {
            for (int w = 0; w < matriu[0].length; w++) {
                matriu[i][w] = sc.nextInt();
            }
        }
        return matriu;
    }
    public static boolean esticDins(int f, int c, int[][] matriu) {
        return f >= 0 && f < matriu.length && c >= 0 && c < matriu[0].length;
    }
}