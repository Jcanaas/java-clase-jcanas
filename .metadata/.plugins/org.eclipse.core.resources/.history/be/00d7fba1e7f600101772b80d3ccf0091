package ejercicios;
import java.util.*;

public class Spederman {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int rows = sc.nextInt();
        int cols = sc.nextInt();

        String[][] matriu = JCllenarmatriz(sc, rows, cols);

        String r = "NO";
        for (int i = 0; i < rows && r.equals("NO"); i++) {
            for (int w = 0; w < cols; w++) {
                if ("SPIDERMAN".equals(matriu[i][w])) {
                    r = "SPIDERMAN";
                    break;
                }
            }
        }

        System.out.println(r);
        sc.close();
    }

    public static String[][] JCllenarmatriz(Scanner sc, int rows, int cols) {
        String[][] matriu = new String[rows][cols];
        for (int i = 0; i < rows; i++) {
            for (int w = 0; w < cols; w++) {
                matriu[i][w] = sc.next();
            }
        }
        return matriu;
    }
}