package ejercicios;
import java.util.*;

public class Travolta {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int y = sc.nextInt();
        int x = sc.nextInt();
        int z = sc.nextInt();

        int[][] matriu = new int[y][x];
        JCllenarmatriz(sc, matriu);
        System.out.println(JCllenarmatriz2(matriu, z));

        sc.close();
    }

    public static String JCllenarmatriz2(int[][] matriu, int z) {
        int rows = matriu.length;
        int cols = matriu[0].length;
        
        for (int i = 0; i < rows; i++) {
            for (int w = 1; w < cols - 1; w++) {
                if (matriu[i][w - 1] == z && matriu[i][w] == z && matriu[i][w + 1] == z) {
                    return "SI";
                }
            }
        }
        return "NO";
    }

    public static void JCllenarmatriz(Scanner sc, int[][] matriu) {
        for (int i = 0; i < matriu.length; i++) {
            for (int w = 0; w < matriu[0].length; w++) {
                matriu[i][w] = sc.nextInt();
            }
        }
    }
}