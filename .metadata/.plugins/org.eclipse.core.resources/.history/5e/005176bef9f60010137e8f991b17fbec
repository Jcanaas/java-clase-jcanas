package ejercicios;

import java.util.Scanner;

public class No_posis_la_casa_al_costat_dun_Cementiri {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        
            int filas = sc.nextInt();
            int cols = sc.nextInt();

            int[][] matriu = JCllenarmatriz(filas, cols, sc);

            int x = sc.nextInt(); 
            int y = sc.nextInt() -1; 

            if (!esticDins(x, y, matriu) || matriu[x][y] != 1) {
                System.out.println("La casella no es valida");
            } else {
                String enemics = "SI";
                for (int dx = -1; dx <= 1; dx++) {
                    for (int dy = -1; dy <= 1; dy++) {
                        if ((dx == 0 && dy == 0)||(dx == 1 && dy == 1)||(dx == -1 && dy == -1)) {
                            
                        } else {
                            int nx = x + dx;
                            int ny = y + dy;
                            if (esticDins(nx, ny, matriu) && matriu[nx][ny] == 4) {
                                enemics = "NO";
                            }
                        }
                    }
                }
                System.out.println(enemics);
            }
        
        sc.close();
    }

    public static int[][] JCllenarmatriz(int filas, int cols, Scanner sc) {
        int[][] matriu = new int[filas][cols];
        for (int i = 0; i < matriu.length; i++) {
            for (int w = 0; w < matriu[0].length; w++) {
                matriu[i][w] = sc.nextInt();
            }
        }
        return matriu;
    }
    public static boolean esticDins(int f, int c, int[][] matriu) {
        return f >= 0 && f < matriu.length && c >= 0 && c < matriu[0].length;
    }
}